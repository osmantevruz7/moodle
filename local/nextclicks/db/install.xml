<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/nextclicks/db" VERSION="2026020200" COMMENT="Next-click tracking tables">
  <TABLES>

    <TABLE NAME="local_nextclicks_last" COMMENT="Stores last viewed item per user and course">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="User ID"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
        <FIELD NAME="itemtype" TYPE="char" LENGTH="20" NOTNULL="true" COMMENT="Item type (course or cm)"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Item identifier"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Timestamp of view"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_nextclicks_trans" COMMENT="Transition counts between viewed items">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
        <FIELD NAME="source" TYPE="char" LENGTH="50" NOTNULL="true" COMMENT="Source item key"/>
        <FIELD NAME="target" TYPE="char" LENGTH="50" NOTNULL="true" COMMENT="Target item key"/>
        <FIELD NAME="cnt" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" COMMENT="Transition count"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Last updated time"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_nextclicks_events" COMMENT="Individual learner navigation events — one row per page view, ordered by time, for EDM extraction">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="Moodle user ID"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
        <FIELD NAME="itemtype"    TYPE="char" LENGTH="20" NOTNULL="true" COMMENT="course or cm"/>
        <FIELD NAME="itemid"      TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="cmid or courseid"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="Unix timestamp of the event"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_courseid" UNIQUE="false" FIELDS="userid, courseid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_nextclicks_dwell" COMMENT="Tracked dwell time on file resources from client heartbeat pings">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="userid"      TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Moodle user ID"/>
        <FIELD NAME="courseid"    TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
        <FIELD NAME="cmid"        TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course module ID (resource cmid)"/>
        <FIELD NAME="seconds"     TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Tracked dwell seconds for this ping"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Unix timestamp when the ping was stored"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_cmid_user" UNIQUE="false" FIELDS="courseid,cmid,userid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_nextclicks_xapi" COMMENT="xAPI statements received from H5P activities — one row per statement, captured in real time by the event observer">
      <FIELDS>
        <FIELD NAME="id"               TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="userid"           TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="Moodle user ID"/>
        <FIELD NAME="courseid"         TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
        <FIELD NAME="cmid"             TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="Course module ID of the H5P activity"/>
        <FIELD NAME="verb"             TYPE="char" LENGTH="100" NOTNULL="true" COMMENT="xAPI verb local name, e.g. answered, completed, progressed"/>
        <FIELD NAME="objectid"         TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="xAPI object ID — identifies sub-content within the H5P activity"/>
        <FIELD NAME="completion"       TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="0" COMMENT="1 if the learner completed this interaction, 0 otherwise"/>
        <FIELD NAME="success"          TYPE="int"  LENGTH="1"  NOTNULL="true" DEFAULT="0" COMMENT="1 if the learner succeeded, 0 otherwise"/>
        <FIELD NAME="score_raw"        TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Raw score reported by H5P (0 if not present)"/>
        <FIELD NAME="score_min"        TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Minimum possible score (0 if not present)"/>
        <FIELD NAME="score_max"        TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Maximum possible score (0 if not present)"/>
        <FIELD NAME="duration_seconds" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Interaction duration in seconds, parsed from ISO 8601 (0 if not reported)"/>
        <FIELD NAME="timecreated"      TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="Unix timestamp when the statement was received"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_courseid" UNIQUE="false" FIELDS="userid, courseid"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
