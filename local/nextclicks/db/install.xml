<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/nextclicks/db" VERSION="2026020200" COMMENT="Next-click tracking tables">
  <TABLES>

    <TABLE NAME="local_nextclicks_last" COMMENT="Stores last viewed item per user and course">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="User ID"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
        <FIELD NAME="itemtype" TYPE="char" LENGTH="20" NOTNULL="true" COMMENT="Item type (course or cm)"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Item identifier"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Timestamp of view"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_nextclicks_trans" COMMENT="Transition counts between viewed items">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
        <FIELD NAME="source" TYPE="char" LENGTH="50" NOTNULL="true" COMMENT="Source item key"/>
        <FIELD NAME="target" TYPE="char" LENGTH="50" NOTNULL="true" COMMENT="Target item key"/>
        <FIELD NAME="cnt" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" COMMENT="Transition count"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Last updated time"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_nextclicks_events" COMMENT="Individual learner navigation events — one row per page view, ordered by time, for EDM extraction">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
        <FIELD NAME="userid"      TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="Moodle user ID"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
        <FIELD NAME="itemtype"    TYPE="char" LENGTH="20" NOTNULL="true" COMMENT="course or cm"/>
        <FIELD NAME="itemid"      TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="cmid or courseid"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true" COMMENT="Unix timestamp of the event"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_courseid" UNIQUE="false" FIELDS="userid, courseid"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
